# Public client configuration. Set different values for Preview and Production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Set through the staging secret manager.
LAUNCHSTUDIO_STAGING_DATABASE_URL=
PICKAXE_STAGING_API_KEY=
PICKAXE_STAGING_WORKSPACE_ID=

# Production target only. Never copy staging credentials into these bindings.
# Project reference is public configuration; credentials below stay server-side.
LAUNCHSTUDIO_PRODUCTION_SUPABASE_PROJECT_REF=
LAUNCHSTUDIO_PRODUCTION_DATABASE_URL=
PICKAXE_PRODUCTION_API_KEY=
PICKAXE_PRODUCTION_WORKSPACE_ID=
